# Live exports from real devices: never commit
live-configs/
*.running
*-running-config*
*.startup
show-run*.txt
show-tech*.txt

# Backups and bundles that contain device identity or secrets
*.tgz
configBundle-*
*.vbk
*.vib

# Local secrets
.env
*.key
*.pem
secrets*
passwords*

# OS / editor noise
.DS_Store
Thumbs.db
*.swp
.vscode/
.idea/

# RANCID output and credentials (hashes, serials, plain-text switch passwords)
.cloginrc
*.cloginrc
router.db
rancid/
rancid-lab*/
*.bundle

# Tailscale state and keys
tailscaled.state
*.tskey

# Terraform state, provider cache and variable files (passwords)
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log
crash.*.log
